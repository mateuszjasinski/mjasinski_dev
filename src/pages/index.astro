---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import IndexHeader from '../components/IndexHeader.astro';
import Basecamp from '../components/Basecamp.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { readingTimeMinutes, cardDescription } from '../lib/posts';



const latestPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3)
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	
	<body>
		<Header />
		<main>
			<IndexHeader/>
			<section class="mt-20">
				<header class="border-b border-slate-800/70 pb-6">
					<h2 class="m-0 text-xl text-slate-50 md:text-4xl">Latest posts</h2>
					<p class="eyebrow-sub mt-2 mb-0">
						Waypoints along the route
					</p>
				</header>
				<div class="divide-y divide-slate-800/70">
					{
						latestPosts.map((post, i) => (
							<ArticleCard
								index={i + 1}
								href={`/blog/${post.id}/`}
								title={post.data.title}
								date={post.data.pubDate}
								minutes={readingTimeMinutes(post.body)}
								description={cardDescription(post.data.description, post.body)}
								tags={post.data.tags}
							/>
						))
					}
				</div>
				<a href="/blog" class="no-underline">
					<div class="mt-6 font-sans flex justify-center text-accent transition-colors hover:text-accent-hover">
						See all posts →
					</div>
				</a>
			</section>
			<Basecamp />
		</main>
		<Footer />
	</body>
</html>
