---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import "../styles/global.css";
import IndexHeader from '../components/IndexHeader.astro';



const latestPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3)
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	
	<body>
		<Header />
		<main>
			<IndexHeader/>

			<h4 class="py-8 font-semibold">Latest posts</h3>
			<section>
				<ul>
					{
						latestPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h4>{post.data.title}</h4>
									<p class="text-gray-400 m-0 text-sm">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="text-gray-400 m-0">
										{post.data.description.slice(0, 200)}...
									</p>
								</a>
								<br/>
							</li>
						))
					}
				</ul>
				<a href="/blog" class="decoration-0">
					<div class="flex text-black justify-center">
						See more
					</div>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
