---
import "../styles/global.css"
---

<div class="border-b-[1px] border-cyan-500">
    <div class="flex flex-col items-center text-center">
        <div class="w-full h-48 md:h-64 flex justify-center items-center py-4 relative">
            <div class="absolute rounded-full border-gray-300 left-[15%] lg:left-16 bg-white"><img class="w-6 h-6 md:w-10 md:h-10" src="icons/Kubernetes.svg"/></div>
            <div class="absolute rounded-full border-gray-300 right-17 lg:right-12 bottom-6 bg-white"><img class="w-6 h-6 md:w-10 md:h-10" src="icons/FastAPI.svg"/></div>
            <div class="absolute rounded-full border-gray-300 top-[12%] lg:top-18 bg-white"><img class="w-6 h-6 md:w-10 md:h-10" src="icons/Python.svg"/></div>
            <svg width="100%" height="100%" class="stroke-cyan-500">
                <circle cx="50%" cy="100%" r="70%" fill="transparent"/>
                <circle cx="50%" cy="100%" r="60%" fill="transparent"/>
                <circle cx="50%" cy="100%" r="50%" fill="transparent"/>
                <circle cx="50%" cy="100%" r="40%" fill="transparent"/>
                <circle cx="50%" cy="100%" r="30%" fill="transparent"/>
                <circle cx="50%" cy="100%" r="20%" fill="transparent"/>
                <circle cx="50%" cy="100%" r="10%" fill="transparent"/>
            </svg>
            
        </div>
        <h1 class="font-bold text-4xl p-2 md:p-4 mt-10">
            Say hello to new software ideas
        </h1>     

        <p class="font-light">Corner of the internet, where backend development meets fresh ideas and practical solutions!</p>
    </div>
</div>