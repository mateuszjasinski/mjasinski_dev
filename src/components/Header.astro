---
const pathname =
	"/" + (Astro.url.pathname.replace(import.meta.env.BASE_URL, "").match(/[^/]+/g)?.[0] || "");

const links = [
	{ href: "/", label: "Home" },
	{ href: "/blog", label: "Blog" },
	{ href: "/about", label: "About" },
];

const isActive = (href: string) => pathname === href;
---

<header class="bg-gradient-to-b from-slate-950 to-slate-900">
	<nav
		class="relative mx-auto flex w-[1080px] max-w-[calc(100%-2em)] items-center justify-between gap-4 py-4"
	>
		<!-- Brand -->
		<a href="/" class="no-underline">
			<span class="flex flex-col items-start gap-y-0.5 md:flex-row md:items-baseline md:gap-x-2">
				<span class="font-sans text-xl font-bold text-slate-50">Mateusz Jasiński</span>
				<span class="font-mono text-xs uppercase tracking-wide text-slate-400">
					Senior Software Engineer
				</span>
			</span>
		</a>

		<!-- Desktop nav (md and up) -->
		<div
			class="hidden items-center gap-1 rounded-full border border-slate-700/50 bg-slate-800/40 px-2 py-1.5 backdrop-blur-sm md:flex"
		>
			{
				links.map(({ href, label }) => (
					<a
						href={href}
						aria-current={isActive(href) ? "page" : undefined}
						class:list={[
							"nav-link rounded-full px-4 py-1.5 text-sm font-medium no-underline transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60",
							isActive(href) ? "bg-slate-700/60" : "hover:bg-slate-700/40",
						]}
					>
						{label}
					</a>
				))
			}
		</div>

		<!-- Hamburger toggle (below md) -->
		<button
			id="mobile-menu-toggle"
			type="button"
			class="mobile-toggle shrink-0 rounded-lg text-accent transition-colors hover:bg-slate-800/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 md:hidden"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>

		<!-- Mobile dropdown panel (below md) -->
		<div id="mobile-menu" class="mobile-menu absolute inset-x-0 top-full z-50 mt-2 origin-top md:hidden">
			<div
				class="flex flex-col gap-1 rounded-2xl border border-slate-700/50 bg-slate-900/95 p-2 shadow-lg backdrop-blur-sm"
			>
				{
					links.map(({ href, label }) => (
						<a
							href={href}
							aria-current={isActive(href) ? "page" : undefined}
							class:list={[
								"nav-link rounded-xl px-4 py-3 text-base font-medium no-underline transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60",
								isActive(href) ? "bg-slate-800/70" : "hover:bg-slate-800/50",
							]}
						>
							{label}
						</a>
					))
				}
			</div>
		</div>
	</nav>
</header>

<style>
	/* Nav links — accent by default, brighter when hovered or on the current page.
	   Scoped here so the color reliably wins over the global `a { color: … }` rule. */
	.nav-link {
		color: var(--accent);
	}

	.nav-link:hover,
	.nav-link[aria-current="page"] {
		color: var(--accent-hover);
	}

	/* Hamburger button — three orange bars that morph into an X */
	.mobile-toggle {
		position: relative;
		width: 2.75rem;
		height: 2.75rem;
	}

	.mobile-toggle .bar {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 24px;
		height: 2px;
		border-radius: 9999px;
		background-color: var(--accent);
		transform: translate(-50%, -50%);
		transition:
			transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
			opacity 0.2s ease;
	}

	.mobile-toggle .bar:nth-child(1) {
		transform: translate(-50%, calc(-50% - 7px));
	}

	.mobile-toggle .bar:nth-child(3) {
		transform: translate(-50%, calc(-50% + 7px));
	}

	.mobile-toggle.is-open .bar:nth-child(1) {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.mobile-toggle.is-open .bar:nth-child(2) {
		opacity: 0;
	}

	.mobile-toggle.is-open .bar:nth-child(3) {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	/* Dropdown panel — hidden from a11y tree and tab order when closed */
	.mobile-menu {
		opacity: 0;
		visibility: hidden;
		transform: translateY(-0.5rem);
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0s linear 0.2s;
	}

	.mobile-menu.is-open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0s;
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-toggle .bar,
		.mobile-menu {
			transition-duration: 0s;
		}
	}
</style>

<script>
	const toggle = document.getElementById("mobile-menu-toggle");
	const menu = document.getElementById("mobile-menu");

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			toggle.classList.toggle("is-open", open);
			menu.classList.toggle("is-open", open);
			toggle.setAttribute("aria-expanded", String(open));
		};

		toggle.addEventListener("click", (e) => {
			e.stopPropagation();
			setOpen(toggle.getAttribute("aria-expanded") !== "true");
		});

		// Close after navigating
		menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

		// Close on Escape
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") setOpen(false);
		});

		// Close on click outside
		document.addEventListener("click", (e) => {
			const target = e.target as Node;
			if (!menu.contains(target) && !toggle.contains(target)) setOpen(false);
		});

		// Reset when resizing up to desktop
		window.addEventListener("resize", () => {
			if (window.innerWidth >= 768) setOpen(false);
		});
	}
</script>
